{
  "name": "blogizi",
  "version": "0.5.4",
  "description": "CLI to draft, update, publish markdown posts, and upload images to Blogizi",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "blogizi": "dist/index.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build",
    "sync:skill": "cp SKILL.md skills/blogizi/SKILL.md && cp SKILL.md plugins/blogizi/skills/blogizi/SKILL.md"
  },
  "keywords": [
    "blogizi",
    "blog",
    "markdown",
    "cli",
    "seo",
    "claude-code",
    "agent"
  ],
  "author": "ByteMind",
  "license": "AGPL-3.0-only",
  "homepage": "https://blogizi.com/docs/cli-publishing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytemindlab/blogizi-agent.git"
  },
  "bugs": {
    "url": "https://github.com/bytemindlab/blogizi-agent/issues"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
